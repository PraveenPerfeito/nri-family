# Copy to .env.local and fill in. Never commit real values.

# ── Public (inlined into the browser bundle — nothing secret here) ───────────
# Brand name. Branding is NOT confirmed yet; defaults to "NRI Family Office".
NEXT_PUBLIC_BRAND_NAME=
# Canonical site origin, used for canonical URLs, sitemap, Open Graph and JSON-LD.
# REQUIRED before launch (defaults to http://localhost:3000). No domain decided yet.
NEXT_PUBLIC_SITE_URL=
# Shown on the site only when set. Leave empty until the channel is staffed.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
# Legal entity details. Shown in the footer / policies only when set.
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=

# ── Server only ──────────────────────────────────────────────────────────────
# HTTPS endpoint that receives enquiry form submissions as JSON (CRM, automation
# tool or internal API). Without it, production forms tell visitors that online
# submissions are not enabled yet; development logs a redacted notice instead.
LEADS_WEBHOOK_URL=
# Optional bearer token sent with each webhook request.
LEADS_WEBHOOK_SECRET=
