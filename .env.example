# Copy to .env.local only if you need these. Never commit real values.
#
# Public settings (brand name, domain, contact email/WhatsApp, company details,
# search indexing) are NOT environment variables — edit them in the settings
# block at the top of src/config/site.ts. On Vercel, no environment variables
# are required.

# ── Server only (optional) ───────────────────────────────────────────────────
# On Vercel, enquiries are emailed to `leadsEmail` in src/config/site.ts.
#
# Branded enquiry emails (recommended): a Resend API key (resend.com, free plan:
# 100 emails/day). With it, the site sends its own email: no ads or images,
# reply / WhatsApp / call buttons, and a proper signature. Without it (or if
# Resend fails), FormSubmit is used as the backup.
RESEND_API_KEY=
#
# Optionally, also POST each enquiry as JSON to a webhook (CRM / automation tool):
LEADS_WEBHOOK_URL=
# Optional bearer token sent with each webhook request.
LEADS_WEBHOOK_SECRET=
# Turn the email relay on for hosts other than Vercel (automatic on Vercel).
LEADS_EMAIL_RELAY=
