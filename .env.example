# TEMPLATE ONLY. This file is committed to a PUBLIC repository: keep every
# value below blank. To use one, copy this file to .env.local (git-ignored)
# and fill in the copy. Never put a real key in this file.
#
# Public settings (brand name, domain, contact email/WhatsApp, company details,
# search indexing, and the customer portal's Supabase URL + publishable key)
# are NOT environment variables — edit them in the settings block at the top of
# src/config/site.ts. On Vercel, no environment variables are required.

# ── Server only (optional) ───────────────────────────────────────────────────
# On Vercel, enquiries are emailed to `leadsEmail` in src/config/site.ts.
#
# Branded enquiry emails (recommended): a Resend API key (resend.com, free plan:
# 100 emails/day). With it, the site sends its own email: no ads or images,
# reply / WhatsApp / call buttons, and a proper signature. Without it (or if
# Resend fails), FormSubmit is used as the backup.
RESEND_API_KEY=
#
# Optionally, also POST each enquiry as JSON to a webhook (CRM / automation tool):
LEADS_WEBHOOK_URL=
# Optional bearer token sent with each webhook request.
LEADS_WEBHOOK_SECRET=
# Turn the email relay on for hosts other than Vercel (automatic on Vercel).
LEADS_EMAIL_RELAY=

# ── Customer portal (/app), local development and tests only ────────────────
# The live site reads these from src/config/site.ts (supabaseUrl,
# supabasePublishableKey, customerSignupsOpen). Set them here only to point a
# local server at a different (test) Supabase project. Both values are public.
SUPABASE_URL=
# The publishable key (starts with sb_publishable_). Never the secret key.
SUPABASE_PUBLISHABLE_KEY=
# "true" shows the registration form; must match the project's
# "Allow new users to sign up" setting.
CUSTOMER_SIGNUPS_OPEN=

# ── Scripts only — the app never reads these ────────────────────────────────
# Admin key (a Supabase secret key, created under Project Settings → API Keys)
# for scripts/portal-e2e.mjs and scripts/seed-demo.mjs. It bypasses
# Row Level Security: keep it on your computer, never in src/, Vercel or git.
SUPABASE_SERVICE_ROLE_KEY=
